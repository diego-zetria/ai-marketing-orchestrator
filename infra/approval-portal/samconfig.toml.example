version = 0.1

[default.deploy.parameters]
stack_name = "approval-portal"
resolve_s3 = true
s3_prefix = "approval-portal"
region = "us-east-1"
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND CAPABILITY_NAMED_IAM"
confirm_changeset = true
parameter_overrides = [
    "Environment=staging",
    "DatabaseUrl=postgresql+asyncpg://user:password@host:5432/dbname",
    "ClickupApiToken=your-clickup-api-token",
    "JwtSecret=your-jwt-secret-at-least-32-chars",
    "SesFromEmail=approvals@example.com",
    "PortalDomain=approvals.example.com",
    "ApiDomain=api-approvals.example.com",
    "AcmCertificateArn=arn:aws:acm:us-east-1:ACCOUNT:certificate/ID",
    "VpcSubnetIds=subnet-xxx,subnet-yyy",
    "VpcSecurityGroupId=sg-zzz",
    "WhatsAppPhoneNumberId=",
    "WhatsAppAccessToken=",
]

[prod.deploy.parameters]
stack_name = "approval-portal-prod"
resolve_s3 = true
s3_prefix = "approval-portal"
region = "us-east-1"
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND CAPABILITY_NAMED_IAM"
confirm_changeset = true
parameter_overrides = [
    "Environment=prod",
]
